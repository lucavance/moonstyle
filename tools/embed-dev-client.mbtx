----
import { "moonbitlang/async@0.22.5", "moonbitlang/async@0.22.5/fs" }
----
async fn main {
  let source = @fs.read_file("tooling/browser/src/main.mbt").text()
  let lines = source.split("\n").map(line => "  #|" + line.to_owned()).collect()
  @fs.mkdir("tooling/native/src/devserver", recursive=true, allow_exist=true)
  @fs.write_file("tooling/native/src/devserver/browser.generated.mbt", "// Generated by tools/embed-dev-client.mbtx. Embeds MoonBit source for installed CLI use.\n\n///|\nlet browser_source : String =\n" + lines.join("\n") + "\n")
}

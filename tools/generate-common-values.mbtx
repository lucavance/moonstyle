----
import {
  "moonbitlang/async@0.22.5",
  "moonbitlang/async@0.22.5/fs",
  "moonbitlang/async@0.22.5/shell",
}
----

///|
async fn main {
  let values = StringBuilder()
  let builder = StringBuilder()
  let facade = StringBuilder()
  values.write_string("// Generated by tools/generate-common-values.mbtx.\n")
  builder.write_string("// Generated by tools/generate-common-values.mbtx.\n")
  facade.write_string(
    "// Generated by tools/generate-common-values.mbtx.\n\n///|\npub using @values {\n",
  )
  for
    (family, constructor) in [
      ("BoxSize", "box_size"),
      ("FlexBasis", "flex_basis_value"),
      ("FontSize", "font_size_value"),
      ("LineHeight", "line_height_value"),
    ] {
    values.write_string(
      "\n///|\npub struct \{family} { expression : Expression } derive(Eq, Debug)\n",
    )
    values.write_string(
      "\n///|\npub trait \{family}ValueInput { fn value_expression(Self) -> Expression }\n",
    )
    values.write_string("\n///|\npub trait \{family}Dimension {}\n")
    values.write_string(
      "\n///|\npub trait \{family}ContractExpression { fn contract_expression(Self) -> String }\n",
    )
    values.write_string(
      "\n///|\npub fn[T : \{family}ValueInput] \{constructor}(value : T) -> \{family} { { expression: value.value_expression() } }\n",
    )
    values.write_string(
      "\n///|\npub fn \{family}::expression(self : \{family}) -> Expression { self.expression }\n\n///|\npub fn \{family}::to_css(self : \{family}) -> String { self.expression.to_css() }\n",
    )
    builder.write_string(
      "\n///|\npub trait \{family}Input { fn property_input(Self) -> PropertyInput }\n",
    )
    let sources = [family, "Length", "LengthPercentage", "Percentage"]
    if family == "LineHeight" {
      sources.push("Number")
      sources.push("Double")
    }
    for source in sources {
      let types = [source]
      if source != family && source != "Double" {
        values.write_string(
          "\n///|\npub impl \{family}Dimension for \{source}\n",
        )
      }
      for type_ in types {
        let category = match source {
          "Length" => "length"
          "LengthPercentage" => "length-percentage"
          "Percentage" => "percentage"
          _ => "number"
        }
        let expression = if source == family || type_.has_prefix("MathExpr[") {
          "self.expression()"
        } else if type_.has_prefix("Token[") || type_.has_prefix("DynamicSlot[") {
          "reference_expression(self.variable_use())"
        } else if source == "Double" {
          "literal_expression(authored_number(self).to_css(), \"number\")"
        } else {
          "literal_expression(self.to_css(), \"\{category}\")"
        }
        values.write_string(
          "\n///|\npub impl \{family}ValueInput for \{type_} with fn value_expression(self) { \{expression} }\n",
        )
        if source != "Double" {
          values.write_string(
            "\n///|\npub impl \{family}ContractExpression for \{type_} with fn contract_expression(self) { \{family}ValueInput::value_expression(self).identity() }\n",
          )
        }
        let qualified = if type_ == "Double" {
          "Double"
        } else if type_.contains("[") {
          type_
          .replace_all(old="Token[", new="@values.Token[@values.")
          .replace_all(old="DynamicSlot[", new="@values.DynamicSlot[@values.")
          .replace_all(old="MathExpr[", new="@values.MathExpr[@values.")
        } else {
          "@values." + type_
        }
        let body = if source == family {
          "expression_input(@values.\{constructor}(self).expression())"
        } else {
          "let input = expression_input(@values.\{constructor}(self).expression()); { ..input, value_origin: @ir.LiteralOrigin([input.css]) }"
        }
        builder.write_string(
          "\n///|\npub impl \{family}Input for \{qualified} with fn property_input(self) { \{body} }\n",
        )
      }
    }
    for
      (base, expression) in [
        ("Token", "reference_expression(self.variable_use())"),
        ("DynamicSlot", "reference_expression(self.variable_use())"),
        ("MathExpr", "self.expression()"),
      ] {
      let bound = "[T : \{family}Dimension]"
      values.write_string(
        "\n///|\n#warnings(\"-unused_trait_bound\")\npub impl\{bound} \{family}ValueInput for \{base}[T] with fn value_expression(self) { \{expression} }\n",
      )
      values.write_string(
        "\n///|\npub impl\{bound} \{family}ContractExpression for \{base}[T] with fn contract_expression(self) { \{family}ValueInput::value_expression(self).identity() }\n",
      )
      let body = if base == "MathExpr" {
        "expression_input(@values.\{constructor}(self).expression())"
      } else {
        "let input = expression_input(@values.\{constructor}(self).expression()); { ..input, value_origin: @ir." +
        (if base == "Token" { "TokenOrigin" } else { "DynamicSlotOrigin" }) +
        "(contract_variable(self.variable_use())) }"
      }
      builder.write_string(
        "\n///|\npub impl[T : @values.\{family}Dimension] \{family}Input for @values.\{base}[T] with fn property_input(self) { \{body} }\n",
      )
    }
    facade.write_string("  type \{family},\n  \{constructor},\n")
  }
  builder.write_string(
    "\n///|\npub impl FlexBasisInput for @values.BoxSize with fn property_input(self) { expression_input(@values.flex_basis_value(self).expression()) }\n",
  )
  builder.write_string(
    "\n///|\npub impl[T : CornerRadiusInput] CornerRadiusInputFallbacks for Array[T] with fn fallback_inputs(self) { self.map(value => value.property_input()) }\n",
  )
  for type_ in ["CornerRadius", "BorderRadii"] {
    values.write_string(
      "\n///|\npub extend \{type_} with BoxSizeContractExpression::{contract_expression}\n",
    )
  }
  for type_ in ["Number", "Percentage"] {
    let method_name = if type_ == "Number" { "number" } else { "percentage" }
    values.write_string(
      "\n///|\npub impl FilterAmountDimension for \{type_}\n\n///|\npub impl FilterAmountInput for \{type_} with fn filter_amount(self) { self.\{method_name}_math().expression() }\n",
    )
  }
  for
    (base, expression) in [
      (
        "Token", "reference_expression(self.variable_use()).constrain(\"math:\" + self.variable_use().definition.category.name())",
      ),
      (
        "DynamicSlot", "reference_expression(self.variable_use()).constrain(\"math:\" + self.variable_use().definition.category.name())",
      ),
      ("MathExpr", "self.expression()"),
    ] {
    values.write_string(
      "\n///|\n#warnings(\"-unused_trait_bound\")\npub impl[T : FilterAmountDimension] FilterAmountInput for \{base}[T] with fn filter_amount(self) { \{expression} }\n",
    )
  }
  // Corner and shorthand radii accept all length/percentage inputs, including
  // mixed fallback entries, without changing the existing scalar categories.
  for
    (family, constructor) in [
      ("CornerRadius", "corner_radius"),
      ("BorderRadii", "single_radius"),
    ] {
    if family == "CornerRadius" {
      builder.write_string(
        "\n///|\npub trait CornerRadiusInput { fn property_input(Self) -> PropertyInput }\n\n///|\npub impl CornerRadiusInput for @values.CornerRadius with fn property_input(self) { expression_input(self.expression()) }\n",
      )
    }
    if family == "BorderRadii" {
      builder.write_string(
        "\n///|\npub trait BorderRadiiInput { fn property_input(Self) -> PropertyInput }\n\n///|\npub impl BorderRadiiInput for @values.BorderRadii with fn property_input(self) { expression_input(self.expression()) }\n",
      )
    }
    for source in ["Length", "LengthPercentage", "Percentage"] {
      for type_ in ["@values.\{source}"] {
        builder.write_string(
          "\n///|\npub impl \{family}Input for \{type_} with fn property_input(self) { expression_input(@values.\{constructor}(self).expression()) }\n",
        )
      }
    }
    for base in ["Token", "DynamicSlot", "MathExpr"] {
      builder.write_string(
        "\n///|\npub impl[T : @values.BoxSizeDimension] \{family}Input for @values.\{base}[T] with fn property_input(self) { expression_input(@values.\{constructor}(self).expression()) }\n",
      )
    }
  }
  for family in ["BoxSize", "FlexBasis", "FontSize", "LineHeight"] {
    // Explicit extends make trait methods available through facade re-exports.
    for
      source in [
        family, "Length", "LengthPercentage", "Percentage", "Token", "DynamicSlot",
        "MathExpr",
      ] {
      values.write_string(
        "\n///|\npub extend \{source} with \{family}ContractExpression::{contract_expression}\n\n///|\n#deprecated\npub extend \{source} with \{family}ValueInput::{value_expression}\n",
      )
    }
  }
  for
    family in [
      "BoxSize", "FlexBasis", "FontSize", "LineHeight", "BorderRadii", "BoxSizeKeyword",
      "FontSizeKeyword",
    ] {
    values.write_string(
      "\n///|\npub extend \{family} with Eq::{equal, not_equal}\n\n///|\npub extend \{family} with @moonbitlang/core/debug.Debug::{to_repr}\n",
    )
  }
  for source in ["Number", "Percentage", "Token", "DynamicSlot", "MathExpr"] {
    values.write_string(
      "\n///|\n#deprecated\npub extend \{source} with FilterAmountInput::{filter_amount}\n",
    )
  }
  values.write_string(
    "\n///|\npub extend Number with LineHeightContractExpression::{contract_expression}\n\n///|\n#deprecated\npub extend Number with LineHeightValueInput::{value_expression}\n\n///|\n#deprecated\npub extend BoxSize with FlexBasisValueInput::{value_expression}\n\n///|\npub extend BoxSize with FlexBasisContractExpression::{contract_expression}\n",
  )
  facade.write_string("}\n")
  let normalized = values
    .to_string()
    .split("///|")
    .map(part => {
      let mut block = part.to_owned()
      for
        (family, prefix) in [
          ("BoxSize", "box_size"),
          ("FlexBasis", "flex_basis"),
          ("FontSize", "font_size"),
          ("LineHeight", "line_height"),
        ] {
        if block.contains(family + "ContractExpression") {
          block = block.replace_all(
            old="contract_expression",
            new=prefix + "_contract_expression",
          )
        }
        if family != "BoxSize" && block.contains(family + "ValueInput") {
          block = block.replace_all(
            old="value_expression",
            new=prefix + "_value_expression",
          )
        }
      }
      block
    })
    .to_array()
    .join("///|")
  for
    (path, content) in [
      ("src/values/common_inputs.generated.mbt", normalized),
      ("src/builder/common_inputs.generated.mbt", builder.to_string()),
      ("src/common_inputs.generated.mbt", facade.to_string()),
    ] {
    @fs.write_file(path, content)
    @shell.Cmd("moonfmt", ["-w", path]).run()
  }
}

----
import { "moonbitlang/async@0.22.5", "moonbitlang/async@0.22.5/fs", "moonbitlang/async@0.22.5/shell", "moonbitlang/core/env" }
----
async fn main {
  @shell.Cmd("moon", ["-C", "tooling/native", "run", "src/cmd/benchmark", "--target", "native", "--", @fs.realpath(".")] + @env.args()[1:].to_owned()).run()
}

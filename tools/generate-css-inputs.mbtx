----
import {
  "moonbitlang/async@0.22.5",
  "moonbitlang/async@0.22.5/fs",
  "moonbitlang/async@0.22.5/shell",
}
----

///|
struct InputSpec {
  name : String
  input_method : String
  type_name : String
  expression : String
  existing : Bool
}

///|
fn between(text : String, start : String, end : String) -> String {
  let tail = text.split(start).to_array()
  if tail.length() < 2 {
    abort("Missing generated token: " + start)
  }
  tail[1].split(end).next().unwrap().to_owned()
}

///|
async fn main {
  let filename = "src/builder/rules.generated.mbt"
  let source = @fs.read_file(filename).text()
  let specs : Map[String, InputSpec] = Map([])
  let methods : Map[String, String] = Map([])
  let blocks = source.split("///|").map(part => part.to_owned()).to_array()
  let output = StringBuilder()
  let inputs = StringBuilder()
  let facade = StringBuilder()
  let expression_types = [
    "@values.TransformList", "@values.AnimationTimelines", "@values.TimelineRange",
    "@values.MotionPath", "@values.OffsetPosition", "@values.OffsetAnchor", "@values.OffsetRotate",
    "@values.FilterList", "@values.BoxShadowList", "@values.TextShadowList", "@values.ScrollbarColor",
    "@values.SvgPaint",
  ]
  let comma_types = [
    "@values.EasingFunction", "@properties.AnimationDirection", "@properties.AnimationFillMode",
    "@properties.AnimationPlayState", "@properties.TransitionProperty", "@values.MaskBox",
    "@values.MaskClip", "@values.MaskMode", "@values.MaskComposite",
  ]
  inputs.write_string("// Generated by tools/generate-css-inputs.mbtx.\n")
  facade.write_string(
    "// Generated by tools/generate-css-inputs.mbtx.\n\n///|\npub using @builder {\n",
  )
  for block in blocks {
    if !block.contains("Rule::") || !block.contains("  value : ") {
      continue
    }
    let method_name = between(block, "Rule::", "(")
    if method_name == "animation_name" {
      continue
    }
    let param = between(block, "  value : ", ",")
    let existing = block.contains("pub fn[T : ")
    let trait_name = if existing {
      between(block, "pub fn[T : ", "]")
    } else {
      param.split(".").to_array().last().unwrap().to_owned() + "Input"
    }
    let input_method = if existing {
      between(block, "value.", "()")
    } else {
      "property_input"
    }
    let expr = if existing {
      ""
    } else {
      between(block, "self.append_text(", ", when").split(", ").to_array()[1].to_owned()
    }
    if !specs.contains(trait_name) {
      specs[trait_name] = {
        name: trait_name,
        input_method,
        type_name: param,
        expression: expr,
        existing,
      }
    }
    methods[method_name] = trait_name
  }
  for index, original in blocks {
    let mut block = original
    if block.contains("Rule::") && block.contains("  value : ") {
      let method_name = between(block, "Rule::", "(")
      if methods.get(method_name) is Some(name) {
        let spec = specs[name]
        if !spec.existing {
          block = block
            .replace_all(
              old="pub fn Rule::",
              new="pub fn[T : " + name + "] Rule::",
            )
            .replace_all(
              old="  value : " + spec.type_name + ",",
              new="  value : T,",
            )
            .replace_all(old="self.append_text(", new="self.append_input(")
            .replace_all(
              old=spec.expression + ", when, source, true)",
              new="value.property_input(), when, source, \"\", true)",
            )
        }
      }
    } else if block.contains("Frame::") && block.contains("  value : ") {
      let method_name = between(block, "Frame::", "(")
      if methods.get(method_name) is Some(name) && !specs[name].existing {
        block = block
          .replace_all(
            old="pub fn Frame::",
            new="pub fn[T : " + name + "] Frame::",
          )
          .replace_all(
            old="  value : " + specs[name].type_name + ",",
            new="  value : T,",
          )
      }
    }
    if block.contains("_fallbacks(") && block.contains("  values : Array[") {
      let owner = if block.contains("pub fn Rule::") { "Rule" } else { "Frame" }
      let method_name = between(block, owner + "::", "_fallbacks(")
      if methods.get(method_name) is Some(name) {
        let list_type = between(block, "  values : ", ",")
        block = block
          .replace_all(
            old="pub fn " + owner + "::",
            new="pub fn[T : " + name + "Fallbacks] " + owner + "::",
          )
          .replace_all(old="  values : " + list_type + ",", new="  values : T,")
        if owner == "Rule" {
          let marker = if block.contains("self.append_expression_fallbacks(") {
            "self.append_expression_fallbacks("
          } else {
            "self.append_fallbacks("
          }
          let property = between(block, marker, ",")
          let prefix = block.split(marker).next().unwrap().to_owned()
          block = prefix +
            "self.append_property_fallbacks(" +
            property +
            ", values.fallback_inputs(), when, source)\n}\n"
          // Array adapters preserve the existing source spelling and semantics.
          let base_type = between(list_type, "Array[", "]")
          let array_spec = specs[name]
          let convert = name + "::" + array_spec.input_method + "(value)"
          if name != "CornerRadiusInput" {
            inputs.write_string(
              "\n///|\n#deprecated(\"Use " +
              name[:name.length() - 5].to_owned() +
              "Fallbacks::new().add(...) for ordered fallbacks\", skip_current_package=true)\npub impl " +
              name +
              "Fallbacks for " +
              list_type +
              "\n\n///|\npub impl " +
              name +
              "Fallbacks for " +
              list_type +
              " with fn fallback_inputs(self) { self.map(value => " +
              convert +
              ") }\n",
            )
          }
          ignore(base_type)
        }
      }
    }
    if block.contains("pub fn StyleContract::allow_") &&
      block.contains("  values? : Array[") {
      let value_type = between(block, "values? : Array[", "]")
      let comma = comma_types.contains(value_type)
      let times = value_type == "@values.Time"
      if comma || times {
        let list_type = if times {
          "@values.TimeList"
        } else {
          value_type.split(".").to_array().last().unwrap().to_owned() + "List"
        }
        block = block.replace_all(
          old="  self : StyleContract,",
          new="  self : StyleContract,\n  lists? : Array[" +
            list_type +
            "] = [],",
        )
        if times {
          block = block.replace_all(
            old="expressions.map(value => value.expression().identity()),",
            new="expressions.map(value => value.expression().identity()) + lists.map(value => value.expression().identity()),",
          )
        }
      }
      let expression_type = if block.contains("values? : Array[@values.Color]") {
        "@values.ColorExpr"
      } else if block.contains("values? : Array[@values.MaskImageList]") {
        "@values.Image"
      } else if block.contains("values? : Array[@values.ClipPath]") {
        "@values.BasicShape"
      } else {
        match
          expression_types.search_by(type_name => {
            block.contains("values? : Array[" + type_name + "]")
          }) {
          Some(index) => expression_types[index]
          None => ""
        }
      }
      if expression_type != "" {
        block = block
          .replace_all(
            old="  self : StyleContract,",
            new="  self : StyleContract,\n  expressions? : Array[" +
              expression_type +
              "] = [],",
          )
          .replace_all(
            old="  self.allow_property(",
            new="  self.allow_property(\n    expressions=expressions.map(value => value.expression().identity()),",
          )
      }
      block = block.replace_all(
        old="  self : StyleContract,",
        new="  self : StyleContract,\n  keywords? : Array[@values.CssWideKeyword] = [],",
      )
      let lines = block.split("\n").map(line => line.to_owned()).to_array()
      for i in 0..<lines.length() {
        if lines[i].has_prefix("    values=values.map(") {
          let line = lines[i]
          lines[i] = line[:line.length() - 1].to_owned() +
            " + keywords.map(value => value.to_css())" +
            (if comma { " + lists.map(value => value.to_css())" } else { "" }) +
            ","
        }
      }
      block = lines.join("\n")
    }
    if index > 0 {
      output.write_string("///|")
    }
    output.write_string(block)
  }
  // Multiple properties share one value family and Array adapter.
  let distinct = inputs
    .to_string()
    .split("///|")
    .map(part => part.to_owned())
    .to_array()
  let deduplicated = StringBuilder()
  let seen : Map[String, Bool] = Map([])
  for i, block in distinct {
    if i == 0 {
      deduplicated.write_string(block)
      continue
    }
    let identity = block.trim().to_owned()
    if !seen.contains(identity) {
      seen[identity] = true
      deduplicated.write_string("///|" + block)
    }
  }
  for (_, spec) in specs {
    let name = spec.name
    let family = name[:name.length() - 5].to_owned()
    if comma_types.contains(spec.type_name) {
      let list = family + "List"
      deduplicated.write_string(
        "\n///|\npub struct " +
        list +
        " { values : Array[" +
        spec.type_name +
        "] }\n",
      )
      deduplicated.write_string(
        "\n///|\npub fn " +
        list +
        "::new(values : Array[" +
        spec.type_name +
        "]) -> " +
        list +
        " { { values: values.copy() } }\n",
      )
      let extra_check = if family == "TransitionProperty" {
        "if self.values.length() > 1 && self.values.contains(@properties.TransitionPropertyNone) { return @values.declaration_list([], \"transition-property\").to_css() }; "
      } else {
        ""
      }
      deduplicated.write_string(
        "\n///|\npub fn " +
        list +
        "::to_css(self : " +
        list +
        ") -> String { " +
        extra_check +
        "@values.declaration_list(self.values.map(value => @values.declaration_expression(value.to_css(), None)), \"" +
        family +
        "-list\").to_css() }\n",
      )
      deduplicated.write_string(
        "\n///|\npub impl " +
        name +
        " for " +
        list +
        " with fn " +
        spec.input_method +
        "(self) { static_input(self.to_css()) }\n\n///|\npub extend " +
        list +
        " with " +
        name +
        "::{" +
        spec.input_method +
        "}\n",
      )
      facade.write_string("  type " + list + ",\n")
    }
    if !spec.existing {
      let body = if expression_types.contains(spec.type_name) {
        "expression_input(self.expression())"
      } else {
        "let value = self; static_input(" + spec.expression + ")"
      }
      deduplicated.write_string(
        "\n///|\npub trait " +
        name +
        " { fn property_input(Self) -> PropertyInput }\n\n///|\npub impl " +
        name +
        " for " +
        spec.type_name +
        " with fn property_input(self) { " +
        body +
        " }\n",
      )
    }
    deduplicated.write_string(
      "\n///|\npub impl " +
      name +
      " for @values.CssWideKeyword with fn " +
      spec.input_method +
      "(self) { static_input(self.to_css()) }\n",
    )
    deduplicated.write_string(
      "\n///|\npub trait " +
      name +
      "Fallbacks { fn fallback_inputs(Self) -> Array[PropertyInput] }\n",
    )
    deduplicated.write_string(
      "\n///|\npub struct " +
      family +
      "Fallbacks { inputs : Array[PropertyInput] }\n",
    )
    deduplicated.write_string(
      "\n///|\npub fn " +
      family +
      "Fallbacks::new() -> " +
      family +
      "Fallbacks { { inputs: [] } }\n",
    )
    deduplicated.write_string(
      "\n///|\npub fn[T : " +
      name +
      "] " +
      family +
      "Fallbacks::add(self : " +
      family +
      "Fallbacks, value : T) -> " +
      family +
      "Fallbacks { { inputs: [..self.inputs, value." +
      spec.input_method +
      "()] } }\n",
    )
    deduplicated.write_string(
      "\n///|\npub impl " +
      name +
      "Fallbacks for " +
      family +
      "Fallbacks with fn fallback_inputs(self) { self.inputs.copy() }\n",
    )
    deduplicated.write_string(
      "\n///|\npub extend " +
      family +
      "Fallbacks with " +
      name +
      "Fallbacks::{fallback_inputs}\n",
    )
    facade.write_string("  type " + family + "Fallbacks,\n")
  }
  facade.write_string("}\n")
  @fs.write_file(filename, output.to_string())
  @fs.write_file(
    "src/builder/css_inputs.generated.mbt",
    deduplicated.to_string(),
  )
  @fs.write_file(
    "src/css_inputs.generated.mbt",
    facade.to_string(),
  )
  for
    path in [
      "src/builder/css_inputs.generated.mbt", "src/css_inputs.generated.mbt",
    ] {
    @shell.Cmd("moonfmt", ["-w", path]).run()
  }
}

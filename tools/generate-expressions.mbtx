----
import {
  "moonbitlang/async@0.22.5",
  "moonbitlang/async@0.22.5/fs",
  "moonbitlang/async@0.22.5/shell",
}
----

///|
async fn main {
  let values = StringBuilder()
  let builder = StringBuilder()
  let facade = StringBuilder()
  values.write_string("// Generated by tools/generate-expressions.mbtx.\n")
  builder.write_string("// Generated by tools/generate-expressions.mbtx.\n")
  facade.write_string(
    "// Generated by tools/generate-expressions.mbtx.\n\n///|\npub using @values {\n  type MathExpr,\n  css_min,\n  css_max,\n  css_clamp,\n  percentage_as_length,\n",
  )
  for
    (type_, category, method_name) in [
      ("Length", "length", "length"),
      ("LengthPercentage", "length-percentage", "length_percentage"),
      ("Percentage", "percentage", "percentage"),
      ("Number", "number", "number"),
      ("Angle", "angle", "angle"),
      ("Time", "time", "time"),
      ("Resolution", "resolution", "resolution"),
    ] {
    values.write_string(
      "\n///|\npub trait \{type_}MathInput {\n  fn \{method_name}_math(Self) -> MathExpr[\{type_}]\n}\n" +
      "\n///|\npub fn[T : \{type_}MathInput] math_\{method_name}(value : T) -> MathExpr[\{type_}] { value.\{method_name}_math() }\n",
    )
    for
      (source, expression) in [
        (type_, "literal_expression(self.to_css(), \"\{category}\")"),
        ("Token[\{type_}]", "reference_expression(self.variable_use())"),
        ("DynamicSlot[\{type_}]", "reference_expression(self.variable_use())"),
      ] {
      values.write_string(
        "\n///|\npub impl \{type_}MathInput for \{source} with fn \{method_name}_math(self) {\n" +
        "  math_expression(\{expression}.constrain(\"math:\{category}\"))\n}\n",
      )
    }
    values.write_string(
      "\n///|\npub impl \{type_}MathInput for MathExpr[\{type_}] with fn \{method_name}_math(self) { self }\n",
    )
    for source in [type_, "Token", "DynamicSlot", "MathExpr"] {
      values.write_string(
        "\n///|\npub extend \{source} with \{type_}MathInput::{\{method_name}_math}\n",
      )
    }
    if type_ != "Length" {
      builder.write_string(
        "\n///|\npub impl \{type_}Input for @values.MathExpr[@values.\{type_}] with fn \{method_name}_input(self) { expression_input(self.expression()) }\n",
      )
    }
    facade.write_string("  math_\{method_name},\n")
  }
  facade.write_string("}\n")
  for
    type_ in [
      "Expression", "MathExpr", "ExpressionVariable", "Image", "GradientStop", "ConicPosition",
      "GradientPosition", "GradientDirection", "GradientSide", "RadialShape", "RadialExtent",
      "RadialSize", "LayerAttachment", "LayerBox", "LayerSize", "BackgroundLayer",
      "BackgroundLayers",
    ] {
    values.write_string(
      "\n///|\npub extend \{type_} with Eq::{equal, not_equal}\n\n///|\npub extend \{type_} with @moonbitlang/core/debug.Debug::{to_repr}\n",
    )
  }
  for type_ in ["Color", "Token", "DynamicSlot"] {
    values.write_string(
      "\n///|\npub extend \{type_} with GradientColorInput::{gradient_color}\n",
    )
  }
  for type_ in ["Image", "Url", "Token", "DynamicSlot"] {
    values.write_string(
      "\n///|\npub extend \{type_} with ImageInput::{image_expression}\n",
    )
  }
  values.write_string(
    "\n///|\npub extend MathExpr with LengthContractExpression::{contract_expression}\n",
  )
  @fs.write_file(
    "src/values/math_inputs.generated.mbt",
    values.to_string(),
  )
  @fs.write_file(
    "src/builder/math_inputs.generated.mbt",
    builder.to_string(),
  )
  @fs.write_file("src/math.generated.mbt", facade.to_string())
  for
    filename in [
      "src/values/math_inputs.generated.mbt", "src/builder/math_inputs.generated.mbt",
      "src/math.generated.mbt",
    ] {
    @shell.Cmd("moonfmt", ["-w", filename]).run()
  }
}

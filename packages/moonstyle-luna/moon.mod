name = "lampclaw/moonstyle-luna"

version = "0.3.0"

readme = "README.md"

repository = "https://github.com/lucavance/moonstyle"

license = "MIT"

description = "Optional Luna adapter for lampclaw/moonstyle"

import {
  "lampclaw/moonstyle@0.3.0",
  "mizchi/luna@0.25.2",
  "mizchi/js_web@0.13.1",
  "mizchi/npm_typed@0.1.18",
  "mizchi/signals@0.6.6",
  "moonbit-community/prettyprinter@0.4.11",
  "moonbitlang/lexer@0.4.4",
  "moonbitlang/moon_config@0.4.5",
  "moonbitlang/parser@0.4.6",
  "moonbitlang/regexp@0.3.6",
}

preferred_target = "js"

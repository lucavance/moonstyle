  list.add(self.compiled)
}

///|
pub extend UpstreamDynamicResourceStyle with @runtime.StaticStyleInput::{to_compiled}

///|
pub extend UpstreamDynamicResourceStyle with @runtime.StyleInput::{append_to}

///|
pub fn upstreamDynamicResource(
  demo_resource : @values.Url,
) -> Result[UpstreamDynamicResourceStyle, Array[@runtime.DynamicValueError]] {
  let lampclaw_css_demo_resource = demo_resource.to_css()
  let errors : Array[@runtime.DynamicValueError] = []
  for issue in @values.value_issues(lampclaw_css_demo_resource) {
    errors.push(@runtime.dynamic_value_error("--demo-resource", issue.code, issue.label))
  }
  if !errors.is_empty() {
    return Err(errors)
  }
  Ok(UpstreamDynamicResourceStyle::{ compiled: @runtime.compiled_v5(
[
    ("kKwaWg", Some("x1hbq5dq")),
  ],
    inline_vars=[
    ("--demo-resource", lampclaw_css_demo_resource + ""),
    ],
  ) })
}


///|
pub(all) enum BadgeRecipeSize {
  BadgeRecipeSizeCompact
  BadgeRecipeSizeRoomy
} derive(Eq, Debug)

///|
pub extend BadgeRecipeSize with Eq::{equal, not_equal}

///|
pub extend BadgeRecipeSize with @debug.Debug::{to_repr}

///|
pub fn badge_recipe(
  size? : BadgeRecipeSize = BadgeRecipeSizeCompact,
  muted? : Bool = false,
) -> @runtime.StyleList {
  let mut output = @runtime.style_list()
  output = output.add(badge_recipe__base_0)
  match size {
    BadgeRecipeSizeCompact => {
      output = output.add(badge_recipe__size__compact_0)
    }
    BadgeRecipeSizeRoomy => {
      output = output.add(badge_recipe__size__roomy_0)
    }
  }
  match muted {
    true => {
      output = output.add(badge_recipe__muted__true_0)
    }
    false => {
      ()
    }
  }
  if size == BadgeRecipeSizeRoomy && muted == true {
    output = output.add(badge_recipe__compound__0_0)
  }
  output
}


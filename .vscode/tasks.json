{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "MoonStyle: Rabbita dev",
      "type": "process",
      "command": "vp",
      "args": ["dev"],
      "isBackground": true,
      "problemMatcher": {
        "owner": "moonstyle",
        "source": "lampclaw/moonstyle",
        "applyTo": "allDocuments",
        "fileLocation": ["relative", "${workspaceFolder}/validation"],
        "pattern": {
          "regexp": "^(.+):(\\d+):(\\d+):(\\d+):(\\d+): (error|warning) ([A-Z][A-Z0-9_]*): (.+)$",
          "file": 1,
          "line": 2,
          "column": 3,
          "endLine": 4,
          "endColumn": 5,
          "severity": 6,
          "code": 7,
          "message": 8
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "^\\[moonstyle\\] check-start$",
          "endsPattern": "^\\[moonstyle\\] check-end$"
        }
      },
      "runOptions": {
        "runOn": "folderOpen"
      },
      "presentation": {
        "reveal": "silent",
        "panel": "dedicated",
        "clear": false
      }
    }
  ]
}

///|
pub fn StyleContract::allow_width(
  self : StyleContract,
  keywords? : Array[@values.CssWideKeyword] = [],
  values? : Array[@values.Length] = [],
  expressions? : Array[&@values.BoxSizeContractExpression] = [],
  tokens? : Array[@values.LengthToken] = [],
  slots? : Array[@values.LengthSlot] = [],
) -> StyleContract {
  self.allow_property(
    "width",
    values=values.map(value => value.to_css()) + keywords.map(value => value.to_css()),
    expressions=expressions.map(value => value.box_size_contract_expression()),
    tokens=tokens.map(value => contract_token(value)),
    slots=slots.map(value => contract_slot(value)),
  )
}


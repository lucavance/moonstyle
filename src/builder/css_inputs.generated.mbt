  if self.values.length() > 1 &&
    self.values.contains(@properties.TransitionPropertyNone) {
    return @values.declaration_list([], "transition-property").to_css()
  }
  @values.declaration_list(
    self.values.map(value => {
      @values.declaration_expression(value.to_css(), None)

///|
pub fn application_order_migration_safe(property : String) -> Bool {
  match property {
    "padding" | "paddingBlock" | "paddingInline" | "paddingInlineStart" | "paddingInlineEnd" | "placeItems" | "overflow" | "borderColor" | "borderWidth" | "borderRadius" | "borderStyle" | "borderInlineStartColor" | "borderInlineEndColor" | "borderInlineStartWidth" | "borderInlineEndWidth" | "borderInlineStartStyle" | "borderInlineEndStyle" | "borderStartStartRadius" | "borderStartEndRadius" | "borderEndStartRadius" | "borderEndEndRadius" | "transition" | "paddingRight" | "paddingLeft" | "margin" | "marginLeft" | "marginRight" | "marginBlock" | "marginInline" | "marginInlineStart" | "marginInlineEnd" | "gap" | "right" | "left" | "overflowBlock" | "overflowInline" | "placeContent" | "placeSelf" | "inset" | "insetBlock" | "insetInline" | "insetBlockStart" | "insetBlockEnd" | "insetInlineStart" | "insetInlineEnd" | "gridColumn" | "gridRow" | "gridArea" | "blockSize" | "containIntrinsicBlockSize" | "containIntrinsicInlineSize" | "containIntrinsicSize" | "fontWidth" | "inlineSize" | "marginBlockEnd" | "marginBlockStart" | "maxBlockSize" | "maxInlineSize" | "minBlockSize" | "minInlineSize" | "paddingBlockEnd" | "paddingBlockStart" | "scrollMargin" | "scrollMarginBlock" | "scrollMarginBlockEnd" | "scrollMarginBlockStart" | "scrollMarginInline" | "scrollMarginInlineEnd" | "scrollMarginInlineStart" | "scrollMarginLeft" | "scrollMarginRight" | "scrollPadding" | "scrollPaddingBlock" | "scrollPaddingInline" | "scrollPaddingInlineEnd" | "scrollPaddingInlineStart" | "scrollPaddingLeft" | "scrollPaddingRight" | "scrollSnapType" | "border" | "borderBlock" | "borderBlockColor" | "borderBlockEnd" | "borderBlockEndColor" | "borderBlockEndStyle" | "borderBlockEndWidth" | "borderBlockStart" | "borderBlockStartColor" | "borderBlockStartStyle" | "borderBlockStartWidth" | "borderBlockStyle" | "borderBlockWidth" | "borderBottom" | "borderBottomLeftRadius" | "borderBottomRightRadius" | "borderInline" | "borderInlineColor" | "borderInlineEnd" | "borderInlineStart" | "borderInlineStyle" | "borderInlineWidth" | "borderLeft" | "borderLeftColor" | "borderLeftStyle" | "borderLeftWidth" | "borderRight" | "borderRightColor" | "borderRightStyle" | "borderRightWidth" | "borderTop" | "borderTopLeftRadius" | "borderTopRightRadius" | "outline" | "font" => false
    _ => true
  }
}

///|
pub fn application_order_pseudo_priority100(value : String) -> Int {
  match value {
    ":active" => 17000
    ":any-link" => 8100
    ":autofill" => 11000
    ":blank" => 10200
    ":checked" => 10100
    ":current" => 12500
    ":default" => 10000
    ":dir" => 5000
    ":disabled" => 9200
    ":empty" => 7000
    ":enabled" => 9100
    ":first-child" => 5200
    ":first-of-type" => 5300
    ":focus" => 15000
    ":focusVisible" => 16000
    ":focusWithin" => 14000
    ":fullscreen" => 12200
    ":future" => 12700
    ":has" => 4500
    ":hover" => 13000
    ":in-range" => 9800
    ":indeterminate" => 10100
    ":invalid" => 10400
    ":is" => 4000
    ":lang" => 5100
    ":last-child" => 5400
    ":last-of-type" => 5500
    ":link" => 8000
    ":local-link" => 8200
    ":modal" => 12100
    ":not" => 4000
    ":nth-child" => 6000
    ":nth-last-child" => 6100
    ":nth-last-of-type" => 6300
    ":nth-of-type" => 6200
    ":only-child" => 5600
    ":only-of-type" => 5700
    ":optional" => 9400
    ":out-of-range" => 9900
    ":past" => 12600
    ":paused" => 12300
    ":picture-in-picture" => 12000
    ":placeholder-shown" => 9700
    ":playing" => 12400
    ":read-only" => 9500
    ":read-write" => 9600
    ":required" => 9300
    ":target" => 8400
    ":target-within" => 8300
    ":user-invalid" => 10500
    ":valid" => 10300
    ":visited" => 8500
    ":where" => 4000
    _ => 4000
  }
}

///|
pub fn application_order_at_rule_priority100(value : String) -> Int {
  if value.has_prefix("@container") {
    30000
  } else if value.has_prefix("@media") {
    20000
  } else if value.has_prefix("@supports") {
    3000
  } else {
    300000
  }
}

///|
pub fn application_order_relational_priority100(value : String) -> Int {
  match value {
    "ancestor" => 1000
    "any-sibling" => 2000
    "descendant" => 1500
    "sibling-after" => 4000
    "sibling-before" => 3000
    _ => 4000
  }
}

///|
pub let application_order_relational_fallback_priority100 = 4000

///|
pub let application_order_pseudo_element_priority100 = 500000

///|
fn declaration(
  property : String,
  value : String,
  conditions : Array[@ir.Condition],
) -> @ir.Declaration {
  @ir.declaration(property, @ir.text(value), conditions~, keyframe_allowed=true)
}

///|
fn animation_declaration(
  property : String,
  value : @ir.AnimationName,
  conditions : Array[@ir.Condition],
) -> @ir.Declaration {
  @ir.declaration(property, @ir.animation(value), conditions~)
}

///|
fn fallback_declaration(
  property : String,
  values : Array[String],
  conditions : Array[@ir.Condition],
) -> @ir.Declaration {
  @ir.declaration(property, @ir.fallbacks(values), conditions~, keyframe_allowed=true)
}

///|
pub fn width(
  value : @values.Length,
  conditions? : Array[@ir.Condition] = [],
) -> LayoutDeclaration {
  layout_declaration(declaration("width", value.to_css(), conditions))
}

///|
pub fn width_fallbacks(
  values : Array[@values.Length],
  conditions? : Array[@ir.Condition] = [],
) -> LayoutDeclaration {
  layout_declaration(fallback_declaration("width", values.map(value => value.to_css()), conditions))
}

///|
pub fn dynamic_width(
  variable : @values.CssVar[@values.Length],
) -> LayoutDeclaration {
  layout_declaration(@ir.declaration("width", @ir.dynamic(variable.name(), "", category="length")))
}

///|
pub fn height(value : @values.Length) -> LayoutDeclaration {
  layout_declaration(declaration("height", value.to_css(), []))
}

///|

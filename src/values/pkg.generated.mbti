pub fn Url::value_category(Self) -> ValueCategory
pub impl CssValue for Url
pub impl ImageInput for Url

pub(all) enum ValueCategory {
  LengthCategory
  ColorCategory
  NumberCategory
  PercentageCategory
  LengthPercentageCategory
  IntegerCategory
  TimeCategory
  AngleCategory
  ResolutionCategory
  UrlCategory
} derive(Eq, @debug.Debug)
pub fn ValueCategory::equal(Self, Self) -> Bool
pub fn ValueCategory::name(Self) -> String
pub fn ValueCategory::not_equal(Self, Self) -> Bool
pub fn ValueCategory::to_repr(Self) -> @debug.Repr

